# Supabase project API settings. The URL and publishable (or legacy anon) key
# are safe to expose to browser code when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Server-only secret (or legacy service_role) administrative key. The variable
# keeps its compatibility name. Never prefix it with NEXT_PUBLIC_, commit a
# real value, or bypass RLS for ordinary user requests.
SUPABASE_SERVICE_ROLE_KEY=

# Production canonical URL. For local development, override this in
# .env.local with http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://calisthenics.gillianoagard.com
